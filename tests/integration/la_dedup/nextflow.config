// Run with: nextflow -C tests/integration/la_dedup/nextflow.config run tests/integration/la_dedup/main.nf
// The production DEDUPLICATE_LINEAR settings are included, not copied.
params {
    run_remove_linear_dups = true
    run_read_filter = true
    test_pair_filter = false
    la_complete_templates = true
    minimum_alignment_q_score = 10
    mito_name = null
    genome = null
    aligner = 'bowtie2'
    save_align_intermed = false
    run_mark_dups = false
    run_remove_dups = false
    run_reporting = false
    run_peak_qc = false
    run_genome_prep = false
    run_input_check = false
    run_cat_fastq = false
    run_trim_galore_fastqc = false
    run_alignment = false
    run_preseq = false
    run_peak_calling = false
    run_consensus_all = false
    run_deeptools_qc = false
    run_deeptools_heatmaps = false
    run_igv = false
    run_multiqc = false
    outdir = 'tiny-results'
    publish_dir_mode = 'copy'
}
includeConfig '../../../conf/modules.config'
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    time = '10 min'
    withName: '.*:SAMTOOLS_MAKE_BAM' {
        ext.args = '--output-fmt bam'
        ext.prefix = 'fixture.input'
    }
    withName: '.*:CHECK_LINEAR_OUTPUT' {
        publishDir = [path: params.outdir, mode: 'copy']
    }
}
// Nextflow normally exposes only projectDir/bin; make this nested harness use
// the same repository helper entry point. The HPC invocation supplies any
// container/cache/bind overrides explicitly and records them.
env.PATH = "${projectDir}/../../../bin:${System.getenv('PATH')}"
